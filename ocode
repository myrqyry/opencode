#!/usr/bin/env bash
set -euo pipefail

# Resolve this launcher through symlinks so `~/.local/bin/ocode` still finds the
# source checkout instead of treating ~/.local/bin as the repository root.
script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
  target="$(readlink "$script_path")"
  if [[ "$target" == /* ]]; then
    script_path="$target"
  else
    script_path="$script_dir/$target"
  fi
done
repo_dir="$(cd -P "$(dirname "$script_path")" && pwd)"

# Keep the custom build separate from the user's stable OpenCode installation.
# Project-local .opencode directories remain shared intentionally; global config,
# plugins, auth/data, state, cache, logs, and temporary files use the ocode namespace.
export OPENCODE_SCRIPT_NAME=ocode
export OPENCODE_APP_NAME=ocode

# Do not inherit explicit global config/database routing intended for stock OpenCode.
unset OPENCODE_CONFIG OPENCODE_CONFIG_CONTENT OPENCODE_CONFIG_DIR OPENCODE_DB

# Interactive shells do not always put Bun on PATH even when BUN_INSTALL is set.
# Prefer PATH, then the configured Bun install, then Bun's standard user install.
bun_bin="$(command -v bun 2>/dev/null || true)"
if [[ -z "$bun_bin" && -n "${BUN_INSTALL:-}" && -x "$BUN_INSTALL/bin/bun" ]]; then
  bun_bin="$BUN_INSTALL/bin/bun"
fi
if [[ -z "$bun_bin" && -x "$HOME/.bun/bin/bun" ]]; then
  bun_bin="$HOME/.bun/bin/bun"
fi
if [[ -z "$bun_bin" ]]; then
  echo "ocode: Bun was not found. Install Bun or add it to PATH." >&2
  exit 127
fi

# Source checkouts do not contain the generated embedded web bundle. Upstream's
# `web` command silently proxies app.opencode.ai in that case, which hides local
# packages/app changes. For ocode, make `web` run the local API and local Vite UI.
# Set OCODE_WEB_UPSTREAM=1 to opt back into the upstream/proxied command.
if [[ "${1:-}" == "web" && "${OCODE_WEB_UPSTREAM:-0}" != "1" ]]; then
  shift
  if [[ $# -ne 0 ]]; then
    echo "ocode web: network flags are not supported by the local dev launcher yet." >&2
    echo "Use OCODE_SERVER_HOST and OCODE_SERVER_PORT instead, or set OCODE_WEB_UPSTREAM=1." >&2
    exit 2
  fi

  backend_host="${OCODE_SERVER_HOST:-127.0.0.1}"
  backend_port="${OCODE_SERVER_PORT:-}"
  if [[ -z "$backend_port" ]]; then
    backend_port="$($bun_bin -e '
      import { createServer } from "node:net"
      const server = createServer()
      server.listen(0, "127.0.0.1", () => {
        const address = server.address()
        if (!address || typeof address === "string") process.exit(1)
        console.log(address.port)
        server.close()
      })
    ')"
  fi

  backend_pid=""
  cleanup() {
    local status=$?
    trap - EXIT INT TERM HUP
    if [[ -n "$backend_pid" ]] && kill -0 "$backend_pid" 2>/dev/null; then
      kill "$backend_pid" 2>/dev/null || true
      wait "$backend_pid" 2>/dev/null || true
    fi
    exit "$status"
  }
  trap cleanup EXIT INT TERM HUP

  "$bun_bin" run --cwd "$repo_dir/packages/opencode" --conditions=browser src/index.ts \
    serve --hostname "$backend_host" --port "$backend_port" &
  backend_pid=$!

  export VITE_OPENCODE_SERVER_HOST="$backend_host"
  export VITE_OPENCODE_SERVER_PORT="$backend_port"

  echo "ocode: local API      http://$backend_host:$backend_port"
  echo "ocode: local web UI   Vite will print and open its URL below"
  echo

  "$bun_bin" run --cwd "$repo_dir/packages/app" dev -- --open
  exit $?
fi

exec "$bun_bin" run --cwd "$repo_dir/packages/opencode" --conditions=browser src/index.ts "$@"
