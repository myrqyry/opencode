{
  "$schema": "https://opencode.ai/desktop-theme.json",
  "name": "Ethereal Fallen Angel",
  "id": "ethereal-fallen-angel",
  "light": {
    "palette": {
      "neutral": "#f3f3f3",
      "ink": "#1b1b1b",
      "primary": "#6d6d6d",
      "accent": "#806666",
      "success": "#158224",
      "warning": "#896801",
      "error": "#c02f38",
      "info": "#9a5758"
    }
  },
  "dark": {
    "palette": {
      "neutral": "#080808",
      "ink": "#f0f0f0",
      "primary": "#ffffff",
      "accent": "#ffe0e0",
      "warning": "#ffd166",
      "error": "#ff6b6b",
      "info": "#ffb3b3",
      "success": "#37d247"
    },
    "overrides": {
      "background-base": "#080808",
      "text-base": "#f0f0f0"
    }
  }
}
