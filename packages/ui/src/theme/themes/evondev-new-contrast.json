{
  "$schema": "https://opencode.ai/desktop-theme.json",
  "name": "Evondev New Contrast",
  "id": "evondev-new-contrast",
  "light": {
    "palette": {
      "neutral": "#f2f3fb",
      "ink": "#1a1a1b",
      "primary": "#c02371",
      "accent": "#81693c",
      "success": "#158224",
      "warning": "#6e7319",
      "error": "#cb1a2a",
      "info": "#985e13"
    }
  },
  "dark": {
    "palette": {
      "neutral": "#1e1f35",
      "ink": "#f8f8fa",
      "primary": "#fe4e9f",
      "accent": "#ffe4b3",
      "warning": "#f1fa8c",
      "error": "#ff5555",
      "info": "#ffb86c",
      "success": "#37d247"
