{
  "$schema": "https://opencode.ai/desktop-theme.json",
  "name": "Sailor Moon Background",
  "id": "sailor-moon-background",
  "light": {
    "palette": {
      "neutral": "#edf4ff",
      "ink": "#171d11",
      "primary": "#39797a",
      "accent": "#657356",
      "success": "#397872",
      "warning": "#896445",
      "error": "#b52991",
      "info": "#397872"
    }
  },
  "dark": {
    "palette": {
      "neutral": "#00245c",
      "ink": "#e8f8d7",
      "primary": "#bdffff",
      "accent": "#e8f8d7",
      "warning": "#fdd3b0",
      "error": "#e055b8",
      "info": "#a0e1d9",
      "success": "#a0e1d9"
    },
    "overrides": {
      "background-base": "#00245c",
      "text-base": "#e8f8d7"
    }
  }
}
