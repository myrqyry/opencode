{
  "$schema": "https://opencode.ai/desktop-theme.json",
  "name": "YouTube Dark",
  "id": "you-tube-dark",
  "light": {
    "palette": {
      "neutral": "#f3f3f3",
      "ink": "#1b1b1b",
      "primary": "#ca1810",
      "accent": "#9a5756",
      "success": "#158224",
      "warning": "#92620a",
      "error": "#ca1810",
      "info": "#ce0f18"
    }
  },
  "dark": {
    "palette": {
      "neutral": "#0f0f0f",
      "ink": "#f1f1f1",
      "primary": "#ff0000",
      "accent": "#ffb3b0",
      "warning": "#f6c177",
      "error": "#ff0000",
      "info": "#ff4e45",
      "success": "#37d247"
    },
    "overrides": {
      "background-base": "#0f0f0f",
      "text-base": "#f1f1f1"
    }
  }
}
