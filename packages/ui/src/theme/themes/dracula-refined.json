{
  "$schema": "https://opencode.ai/desktop-theme.json",
  "name": "Dracula Refined",
  "id": "dracula-refined",
  "light": {
    "palette": {
      "neutral": "#f2f3f7",
      "ink": "#1b1b19",
      "primary": "#7f55b5",
      "accent": "#6d6d6d",
      "success": "#158224",
