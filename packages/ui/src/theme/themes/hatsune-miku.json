{
  "$schema": "https://opencode.ai/desktop-theme.json",
  "name": "Hatsune Miku",
  "id": "hatsune-miku",
  "light": {
    "palette": {
      "neutral": "#f3f3f3",
      "ink": "#1b1b1b",
      "primary": "#1b7b75",
      "accent": "#437673",
      "success": "#158224",
      "warning": "#92620a",
      "error": "#c81344",
      "info": "#157c76"
    }
  },
  "dark": {
    "palette": {
      "neutral": "#1a1a1a",
      "ink": "#e6e6e6",
      "primary": "#39c5bb",
      "accent": "#bcf2ee",
      "warning": "#f6c177",
      "error": "#ff0055",
      "info": "#7be1d9",
      "success": "#37d247"
    },
    "overrides": {
      "background-base": "#1a1a1a",
      "text-base": "#e6e6e6"
    }
  }
}
